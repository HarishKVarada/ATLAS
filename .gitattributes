# Default: normalize all text files to LF
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Linux / Unix scripts
*.sh text eol=lf

# Python
*.py text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# JSON
*.json text eol=lf

# TOML
*.toml text eol=lf

# GitHub Actions
.github/** text eol=lf